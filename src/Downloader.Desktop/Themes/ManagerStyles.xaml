<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YouTubeDownloader">
 <Style x:Key="ManagerCount" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="CornerRadius" Value="20"/><Setter Property="MinWidth" Value="23"/><Setter Property="Height" Value="23"/><Setter Property="Padding" Value="6,1"/><Setter Property="Margin" Value="7,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Style.Triggers><DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="NavigationCount" TargetType="Border" BasedOn="{StaticResource ManagerCount}"><Setter Property="Background" Value="{DynamicResource NavigationSelected}"/></Style>
 <Style x:Key="ManagerRowAction" TargetType="Button" BasedOn="{StaticResource QuietButton}">
  <Setter Property="FlowDirection" Value="LeftToRight"/>
  <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8"/>
  <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style x:Key="ManagerProgress" TargetType="ProgressBar">
  <Setter Property="Height" Value="5"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="{DynamicResource Divider}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border x:Name="PART_Track" Background="{TemplateBinding Background}"/><Grid x:Name="PART_Indicator" HorizontalAlignment="Left"><Path Data="M0,0 H100 L94,6 H0 Z" Stretch="Fill" Fill="{TemplateBinding Foreground}"/></Grid></Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="ManagerSource">
  <DockPanel LastChildFill="True" FlowDirection="LeftToRight">
   <Border x:Name="Mark" Width="18" Height="16" CornerRadius="3" Background="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center">
    <Path x:Name="Symbol" Data="{StaticResource GlobeIcon}" Stroke="White" StrokeThickness="1.7" Stretch="Uniform" Width="12" Height="12"/>
   </Border>
   <TextBlock ToolTip="{Binding Url}" Text="{Binding SourceName}" Foreground="{DynamicResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
  </DockPanel>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding SourceKind}" Value="youtube"><Setter TargetName="Mark" Property="Background" Value="#CB2535"/><Setter TargetName="Symbol" Property="Data" Value="M5,3 L15,9 5,15 Z"/><Setter TargetName="Symbol" Property="Fill" Value="White"/><Setter TargetName="Symbol" Property="Width" Value="8"/><Setter TargetName="Symbol" Property="Height" Value="8"/></DataTrigger>
   <DataTrigger Binding="{Binding SourceKind}" Value="vimeo"><Setter TargetName="Mark" Property="Background" Value="#197AA6"/><Setter TargetName="Symbol" Property="Data" Value="M2,6 Q7,1 8,8 L10,15 Q12,18 18,5 M15,5 L18,5"/><Setter TargetName="Symbol" Property="StrokeThickness" Value="2.6"/></DataTrigger>
   <DataTrigger Binding="{Binding SourceKind}" Value="soundcloud"><Setter TargetName="Mark" Property="Background" Value="#B94F0A"/><Setter TargetName="Symbol" Property="Data" Value="M2,9 V14 M5,6 V15 M8,4 V15 M11,7 Q17,3 18,10 Q23,9 23,13 Q23,16 18,16 H11"/></DataTrigger>
   <DataTrigger Binding="{Binding SourceKind}" Value="linkedin"><Setter TargetName="Mark" Property="Background" Value="#0A66C2"/><Setter TargetName="Symbol" Property="Data" Value="M3,3 V4 M3,8 V19 M9,19 V8 M9,12 Q18,4 18,13 V19"/><Setter TargetName="Symbol" Property="StrokeThickness" Value="3"/></DataTrigger>
   <DataTrigger Binding="{Binding SourceKind}" Value="facebook"><Setter TargetName="Mark" Property="Background" Value="#2164CE"/><Setter TargetName="Symbol" Property="Data" Value="M15,3 H12 Q8,3 8,8 V21 M4,10 H14"/><Setter TargetName="Symbol" Property="StrokeThickness" Value="3"/></DataTrigger>
   <DataTrigger Binding="{Binding IsHighContrast}" Value="True"><Setter TargetName="Mark" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Symbol" Property="Stroke" Value="{DynamicResource OnAccent}"/></DataTrigger>
   <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsHighContrast}" Value="True"/><Condition Binding="{Binding SourceKind}" Value="youtube"/></MultiDataTrigger.Conditions><Setter TargetName="Symbol" Property="Fill" Value="{DynamicResource OnAccent}"/></MultiDataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
 <Style x:Key="VydropPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
  <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="18,10"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid Background="Transparent"><Grid local:InteractionMotion.Enabled="True">
    <Canvas IsHitTestVisible="False"><Path x:Name="Face" Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=Grid}}" Data="M12,0 H240 V48 H0 V12 Z" Stretch="Fill" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"/><Path Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=Grid}}" Data="M12,0 H240 V48 H0 V12 Z" Stretch="Fill" Fill="{DynamicResource OnAccent}" Opacity="0" IsHitTestVisible="False" local:HoverMotion.Enabled="True" local:HoverMotion.Strength="0.1"/></Canvas>
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
   </Grid></Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="Stroke" Value="{DynamicResource Ink}"/><Setter TargetName="Face" Property="StrokeThickness" Value="2"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".85"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LibraryNavigation" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="{DynamicResource NavigationInk}"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="10,3"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Grid Background="Transparent"><Grid local:InteractionMotion.Enabled="True">
    <Path x:Name="Face" Data="M0,0 H240 V35 L227,48 H0 Z" Stretch="Fill" Fill="{TemplateBinding Background}" Stroke="Transparent" StrokeThickness="1"/>
    <Path x:Name="NavigationSelection" Data="M0,0 H240 V35 L227,48 H0 Z" Stretch="Fill" Fill="{DynamicResource NavigationSelected}" Opacity="0" IsHitTestVisible="False" local:SelectionMotion.IsSelected="{Binding IsChecked,RelativeSource={RelativeSource TemplatedParent}}"/>
    <Path Data="M0,0 H240 V35 L227,48 H0 Z" Stretch="Fill" Fill="{DynamicResource NavigationSelected}" Opacity="0" IsHitTestVisible="False" local:HoverMotion.Enabled="True" local:HoverMotion.Strength="0.45"/>
    <Grid Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Path x:Name="NavigationGlyph" Data="{TemplateBinding Tag}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource NavigationIcon}" Width="19" Height="19"/>
     <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
    </Grid>
    <Path x:Name="NavigationFocus" Data="M0,0 H240 V35 L227,48 H0 Z" Stretch="Fill" Stroke="Transparent" StrokeThickness="2" IsHitTestVisible="False"/>
   </Grid></Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavigationGlyph" Property="Stroke" Value="{DynamicResource NavigationSelectedInk}"/><Setter Property="Foreground" Value="{DynamicResource NavigationSelectedInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Stroke" Value="{DynamicResource NavigationMuted}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavigationFocus" Property="Stroke" Value="{DynamicResource NavigationInk}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LibraryFilter" TargetType="ToggleButton">
  <Setter Property="Margin" Value="0,0,14,0"/>
  <Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="8,9"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle"><Setter.Value><Style TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border Height="3" VerticalAlignment="Bottom" Background="{DynamicResource Ink}"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Grid Background="Transparent">
    <ContentPresenter x:Name="FilterContent" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
    <Border x:Name="FilterSelection" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Action}" IsHitTestVisible="False" RenderTransformOrigin=".5,.5" local:UnderlineMotion.IsSelected="{Binding IsChecked,RelativeSource={RelativeSource TemplatedParent}}"><Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform></Border>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LibraryRow" TargetType="ListBoxItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,14"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
    <ContentPresenter Margin="{TemplateBinding Padding}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="{DynamicResource SelectedBorderThickness}"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Divider}"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Face" Property="BorderThickness" Value="{DynamicResource SelectedBorderThickness}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
