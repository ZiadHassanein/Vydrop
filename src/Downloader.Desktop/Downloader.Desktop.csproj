<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><UseWPF>true</UseWPF><AssemblyName>Vydrop</AssemblyName><Product>Vydrop</Product><Title>Vydrop</Title><Description>Vydrop video and audio downloader</Description>
    <ApplicationIcon>../../assets/app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><PublishTrimmed>false</PublishTrimmed><DebugType>none</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Downloader.Core/Downloader.Core.csproj"/><ProjectReference Include="../Downloader.Infrastructure/Downloader.Infrastructure.csproj"/>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
    <Resource Include="../../assets/app.ico" Link="Assets/app.ico"/>
    <Resource Include="../../assets/fonts/*.otf" Link="Assets/Fonts/%(Filename)%(Extension)"/><Resource Include="../../assets/fonts/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)"/>

  </ItemGroup>
  <PropertyGroup>
    <BundledBrowserDirectory>$(MSBuildProjectDirectory)\obj\browser-companion\$(Configuration)\$(ViFreePreview)\Browser</BundledBrowserDirectory>
    <BundledBrowserArchive>$(BundledBrowserDirectory)\..\Vydrop-browser.zip</BundledBrowserArchive>
    <BundledBrowserArchive Condition="'$(ViFreePreview)' == 'true'">$(BundledBrowserDirectory)\..\Vydrop-browser-preview.zip</BundledBrowserArchive>
    <BundledBrowserPreviewArgument Condition="'$(ViFreePreview)' == 'true'">-Preview</BundledBrowserPreviewArgument>
  </PropertyGroup>
  <ItemGroup>
    <BundledBrowserInput Include="../../browser/common/*;../../browser/README.md;../../browser/public-key.txt;../../scripts/package-browser.ps1;../Downloader.Infrastructure/Browser/BrowserIdentity.cs;../../LICENSE;../../assets/brand-logo-dark.svg;../../assets/browser-icon-*.png"/>
    <EmbeddedResource Include="$(BundledBrowserArchive)" LogicalName="YouTubeDownloader.BrowserCompanion"/>
  </ItemGroup>
  <Target Name="PrepareBundledBrowser" BeforeTargets="AssignTargetPaths" Inputs="@(BundledBrowserInput)" Outputs="$(BundledBrowserArchive)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\package-browser.ps1&quot; -OutputDirectory &quot;$(BundledBrowserDirectory)&quot; $(BundledBrowserPreviewArgument)"/>
  </Target>
</Project>
