<UserControl x:Class="YouTubeDownloader.QueueComposerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YouTubeDownloader"
 Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <Style x:Key="QueueButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,5"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="QueueQuietButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,4"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="QueuePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="14,6"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="QueueOutputCaption" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="QueueOutputCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="36"/><Setter Property="Height" Value="36"/>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="QueueContent" Margin="24,4,24,20" FlowDirection="{Binding ContentDirection}"
       TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight" KeyboardNavigation.TabNavigation="Continue">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding AddQueueLabel}" FontSize="26" LineHeight="34" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <ScrollViewer x:Name="QueueViewport" Grid.Row="1" Style="{StaticResource InsetScrollFrame}"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="{Binding QueueInputLabel}" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ItemsControl x:Name="QueueInputFields" ItemsSource="{Binding QueueLinkInputs}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Ink}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="QueueLinkField" Text="{Binding Url,UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource LatinFont}"
                  FlowDirection="LeftToRight" TextAlignment="{Binding DataContext.InputTextAlignment,RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="NoWrap" AcceptsReturn="False" DataObject.Pasting="LinkPasting"
                  AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Error}">
          <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
           <Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,4"/>
           <Style.Triggers>
           <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Error}"/></DataTrigger>
          </Style.Triggers></Style></TextBox.Style>
         </TextBox>
         <TextBlock Text="{Binding LinkHint}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                    FlowDirection="LeftToRight" TextAlignment="{Binding DataContext.InputTextAlignment,RelativeSource={RelativeSource AncestorType=UserControl}}" TextTrimming="CharacterEllipsis">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Url}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
         <Button Grid.Column="2" Content="{Binding DataContext.PasteLabel,RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Command="{Binding DataContext.PasteQueueLinkCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Click="LinkActionClicked" Style="{StaticResource QueueButton}" MinWidth="60"/>
         <Button Grid.Column="4" Command="{Binding DataContext.RemoveLinkFieldCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                 CommandParameter="{Binding}" Click="LinkActionClicked" Style="{StaticResource QueueButton}" Width="36" Padding="0"
                 ToolTip="{Binding DataContext.RemoveLinkLabel,RelativeSource={RelativeSource AncestorType=UserControl}}"
                 AutomationProperties.Name="{Binding DataContext.RemoveLinkLabel,RelativeSource={RelativeSource AncestorType=UserControl}}">
          <Path Data="{StaticResource CloseIcon}" Style="{StaticResource LineIcon}" Width="14" Height="14"/>
         </Button>
        </Grid>
        <TextBlock Text="{Binding StatusLabel}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,9,0,0" Visibility="{Binding HasPendingOutput,Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel Margin="0,9,0,0" Visibility="{Binding HasOutputOptions,Converter={StaticResource BoolVisibility}}">
         <StackPanel Width="120" Margin="0,0,10,8">
          <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource QueueOutputCaption}"/>
          <ComboBox x:Name="QueueMediaType" ItemsSource="{Binding MediaTypes}" SelectedValuePath="Audio" SelectedValue="{Binding Audio,Mode=TwoWay}"
                    IsEnabled="{Binding CanChooseOutput}" Style="{StaticResource QueueOutputCombo}" AutomationProperties.Name="{Binding TypeAccessibleName}">
           <ComboBox.ItemTemplate><DataTemplate>
            <StackPanel Orientation="Horizontal"><Path x:Name="KindIcon" Data="{StaticResource VideoIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{Binding Label}" TextWrapping="NoWrap"/></StackPanel>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding Audio}" Value="True"><Setter TargetName="KindIcon" Property="Data" Value="{StaticResource AudioIcon}"/></DataTrigger></DataTemplate.Triggers>
           </DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
         </StackPanel>
         <StackPanel Width="108" Margin="0,0,10,8">
          <TextBlock Text="{Binding FormatLabel}" Style="{StaticResource QueueOutputCaption}"/>
          <ComboBox x:Name="QueueOutputFormat" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat,Mode=TwoWay}"
                    IsEnabled="{Binding CanChooseOutput}" Style="{StaticResource QueueOutputCombo}" AutomationProperties.Name="{Binding FormatAccessibleName}"/>
         </StackPanel>
         <StackPanel Width="176" Margin="0,0,10,8">
          <TextBlock Text="{Binding QualityLabel}" Style="{StaticResource QueueOutputCaption}"/>
          <ComboBox x:Name="QueueOutputQuality" ItemsSource="{Binding Qualities}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedQualityKey,Mode=TwoWay}"
                    IsEnabled="{Binding CanChooseQuality}" Style="{StaticResource QueueOutputCombo}" AutomationProperties.Name="{Binding QualityAccessibleName}"/>
         </StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding OutputHint}" FontSize="12" Foreground="{DynamicResource Muted}" Visibility="{Binding HasOutputHint,Converter={StaticResource BoolVisibility}}"/>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Error}" FontSize="12" Margin="0,6,0,0"
                   Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button x:Name="AddLinkFieldButton" Command="{Binding AddLinkFieldCommand}" Click="LinkActionClicked" Style="{StaticResource QueueQuietButton}" HorizontalAlignment="Left" Padding="0,4" Margin="0,0,0,8">
     <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlusIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{Binding AddAnotherLinkLabel}"/></StackPanel>
    </Button>
    <Grid Margin="0,0,0,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding QueueSettingsHint}" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="18" VerticalAlignment="Center"/>
     <Button x:Name="AddQueueLinksButton" Grid.Column="2" Command="{Binding AddLinksCommand}" Click="SubmitLinksClicked" Style="{StaticResource QueueButton}" MinWidth="124" AutomationProperties.Name="{Binding AddQueueLabel}">
      <StackPanel Orientation="Horizontal">
       <Path Data="{StaticResource PlusIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="16" Height="16" Margin="0,0,8,0"/>
       <TextBlock Text="{Binding AddQueueLabel}" TextWrapping="NoWrap"/>
      </StackPanel>
     </Button>
    </Grid>
    <Border x:Name="QueueNotice" Background="{DynamicResource Surface}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding QueueMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <TextBlock Text="{Binding QueueMessage}" Foreground="{DynamicResource Ink}" AutomationProperties.LiveSetting="Polite"/>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border x:Name="QueueFooter" Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="QueueCloseButton" Content="{Binding BackToQueueLabel}" Click="CloseClicked" Style="{StaticResource QueueButton}" MinWidth="76"/>
    <Button x:Name="QueuePauseButton" Grid.Column="2" Content="{Binding PauseQueueLabel}" Command="{Binding QueuePauseCommand}" Style="{StaticResource QueueButton}" Margin="0,0,8,0" Visibility="{Binding QueueRunning,Converter={StaticResource BoolVisibility}}"/>
    <Button x:Name="QueueCancelButton" Grid.Column="3" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Style="{StaticResource QueueButton}" Margin="0,0,10,0" Visibility="{Binding QueueRunning,Converter={StaticResource BoolVisibility}}"/>
    <Button x:Name="QueueStartButton" Grid.Column="4" Content="{Binding StartQueueLabel}" Command="{Binding QueueDownloadCommand}" Click="SubmitLinksClicked" Style="{StaticResource QueuePrimaryButton}" MinWidth="136"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
