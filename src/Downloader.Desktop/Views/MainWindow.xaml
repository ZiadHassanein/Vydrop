<Window x:Class="YouTubeDownloader.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YouTubeDownloader"
 Title="Vydrop" Icon="pack://application:,,,/Vydrop;component/Assets/app.ico"
 Width="1000" Height="740" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource LatinFont}" FontSize="14"
 UseLayoutRounding="True" SnapsToDevicePixels="True" FlowDirection="LeftToRight"
 TextBlock.LineHeight="22" TextBlock.LineStackingStrategy="BlockLineHeight">
 <Grid x:Name="Root" Background="{DynamicResource Page}">
  <local:DownloadManagerView x:Name="ManagerContent"/>
  <Grid x:Name="LibraryNoticeHost" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="660" Margin="24" Panel.ZIndex="30"/>
  <Grid x:Name="EditorOverlay" Background="{DynamicResource Page}" Visibility="Collapsed" Panel.ZIndex="40">
   <Border x:Name="EditorSurface" Background="{DynamicResource Page}" Margin="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid x:Name="EditorHeader" Margin="24,4,24,12">
      <TextBlock x:Name="EditorHeading" Text="{Binding AddDownloadLabel}" FontFamily="{Binding ContentFont}" FlowDirection="{Binding ContentDirection}" FontSize="34" LineHeight="44" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </Grid>
   <Grid Grid.Row="1" FlowDirection="LeftToRight">
    <ScrollViewer x:Name="Viewport" Style="{StaticResource VerticalScrollFrame}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FlowDirection="{Binding ContentDirection}">
     <Grid x:Name="FormContent" MinHeight="{Binding ViewportHeight,ElementName=Viewport}" FlowDirection="{Binding ContentDirection}">
      <local:DownloadFormView x:Name="DownloadForm" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
     </Grid>
    </ScrollViewer>
    <ScrollViewer x:Name="ContextViewport" Style="{StaticResource VerticalScrollFrame}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FlowDirection="{Binding ContentDirection}">
    <Grid x:Name="ContextPane" MaxWidth="840" Margin="24,12,24,24">
     <local:MediaPreviewView x:Name="MediaPreview"/>
     <local:SettingsView x:Name="SettingsPane" Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}"/>
    </Grid>
    </ScrollViewer>
   </Grid>

    </Grid>
   </Border>
  </Grid>
  <Border x:Name="Notice" Visibility="{Binding MainNoticeVisible,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Surface}"
          BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0"
          FlowDirection="LeftToRight" TextElement.FontFamily="{Binding ContentFont}" VerticalAlignment="Top">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding NoticeLeadingWidth}"/><ColumnDefinition Width="{Binding NoticeTrailingWidth}"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="{Binding NoticeTextColumn}">
     <TextBlock x:Name="NoticeHeading" TextAlignment="{Binding NoticeAlignment}" FlowDirection="LeftToRight" Text="{Binding NoticeHeading}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{Binding NoticeBrush}" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock TextAlignment="{Binding NoticeAlignment}" FlowDirection="LeftToRight" Text="{Binding NoticeDetail}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
     <ProgressBar x:Name="ToolRefreshProgressBar" Value="{Binding ToolRefreshProgress,Mode=OneWay}" IsIndeterminate="{Binding ToolRefreshIndeterminate}" Visibility="{Binding IsRefreshingTools,Converter={StaticResource BoolVisibility}}" Height="4" Margin="0,10,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Field}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding ToolRefreshLabel}"/>
     <Button x:Name="ToolRefreshCancel" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Visibility="{Binding IsRefreshingTools,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </StackPanel>
    <Button x:Name="NoticeDismiss" Grid.Column="{Binding NoticeDismissColumn}" Command="{Binding DismissNoticeCommand}" Padding="8" MinHeight="30" VerticalAlignment="Top" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding DismissLabel}">
     <Path Data="M0,0 L10,10 M10,0 L0,10" Style="{StaticResource LineIcon}" Width="11" Height="11"/>
    </Button>
   </Grid>
  </Border>
  <local:ThemeTransitionView x:Name="ThemeTransition" Panel.ZIndex="100"/>
 </Grid>
</Window>
