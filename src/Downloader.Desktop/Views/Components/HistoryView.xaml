<UserControl x:Class="YouTubeDownloader.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Ink}" Background="{DynamicResource Page}">
 <UserControl.Resources>
  <Style x:Key="HistoryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,5"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,8"/>
   <Setter Property="Margin" Value="0,0,0,2"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Face" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="HistoryContent" Margin="24,20" TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight" KeyboardNavigation.TabNavigation="Continue">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="{Binding Heading}" FontSize="26" LineHeight="34" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
  </StackPanel>
  <ListBox x:Name="HistoryList" FontFamily="{StaticResource LatinFont}" Grid.Row="1" ItemsSource="{Binding Files}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}"
           HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"
           AutomationProperties.Name="{Binding Heading}">
   <ListBox.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource InsetScrollFrame}"/></ListBox.Resources>
   <ListBox.ItemTemplate><DataTemplate>
    <Grid FlowDirection="LeftToRight" ToolTip="{Binding FilePath}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Path Width="24" Height="24" VerticalAlignment="Top" Margin="0,3,0,0">
      <Path.Style><Style TargetType="Path" BasedOn="{StaticResource LineIcon}"><Setter Property="Data" Value="{StaticResource VideoIcon}"/><Setter Property="Stroke" Value="{DynamicResource MediaVideo}"/><Style.Triggers><DataTrigger Binding="{Binding IsAudio}" Value="True"><Setter Property="Data" Value="{StaticResource AudioIcon}"/><Setter Property="Stroke" Value="{DynamicResource MediaAudio}"/></DataTrigger><DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="Stroke" Value="{DynamicResource Error}"/></DataTrigger></Style.Triggers></Style></Path.Style>
     </Path>
     <StackPanel Grid.Column="2">
      <TextBlock FlowDirection="{Binding Title,Converter={StaticResource TextDirection}}" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="20" MaxHeight="40">
       <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
        <Trigger Property="FlowDirection" Value="RightToLeft"><Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/></Trigger>
        <DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <WrapPanel Margin="0,3,0,0">
       <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="18" VerticalAlignment="Center"/>
       <Border Background="{DynamicResource Selected}" CornerRadius="4" Padding="6,0" Margin="6,0,0,0">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
         <DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        </Style.Triggers></Style></Border.Style>
        <TextBlock Text="{Binding MissingLabel}" Foreground="{DynamicResource Error}" FontSize="12" FontWeight="SemiBold" LineHeight="18"/>
       </Border>
      </WrapPanel>
      <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="18" FlowDirection="LeftToRight" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Button Grid.Column="4" Style="{StaticResource HistoryButton}" VerticalAlignment="Center"
             Content="{Binding DataContext.RevealLabel,RelativeSource={RelativeSource AncestorType=UserControl}}"
             Command="{Binding DataContext.RevealCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
             AutomationProperties.HelpText="{Binding FilePath}"/>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel x:Name="HistoryEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}">
   <Path Data="{DynamicResource HistoryIcon}" Style="{DynamicResource LineIcon}" Width="30" Height="30" Stroke="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
   <TextBlock Text="{Binding EmptyHeading}" FontWeight="SemiBold" FontSize="16" TextAlignment="Center"/>
   <TextBlock Text="{Binding EmptyDetail}" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,6,0,0"/>
  </StackPanel>
  <TextBlock x:Name="HistoryError" Grid.Row="2" Text="{Binding Error}" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite"/>

 </Grid>
</UserControl>
