<UserControl x:Class="YouTubeDownloader.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YouTubeDownloader"
 FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}">
 <UserControl.Resources>
  <ToolTip x:Key="DownloaderHelp" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"
           Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Border}" Padding="12" HasDropShadow="False"
           FontSize="14" FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}">
   <TextBlock Text="{Binding ToolRefreshHint}" TextWrapping="Wrap" MaxWidth="300"/>
  </ToolTip>
 </UserControl.Resources>
 <Border Background="Transparent" Padding="0" FlowDirection="{Binding ContentDirection}">
  <StackPanel>
   <Button x:Name="BrowserIntegrationButton" Command="{Binding BrowserCommand}" AutomationProperties.Name="{Binding BrowserLabel}" HorizontalAlignment="Left" Margin="0,0,0,24">
    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource BrowserIcon}" Style="{StaticResource LineIcon}" Width="18" Height="18" Stroke="{DynamicResource Muted}" Margin="0,0,8,0"/><TextBlock Text="{Binding BrowserLabel}"/></StackPanel>
   </Button>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,9"><Path Data="{StaticResource RefreshIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="{Binding UpdateSectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <Button x:Name="UpdateAnchor" Content="{Binding UpdateLabel}" Command="{Binding UpdateCommand}" HorizontalAlignment="Left"/>
   <StackPanel x:Name="UpdateNoticeHost" FlowDirection="LeftToRight"/>
   <Border Height="1" Background="{DynamicResource Divider}" Margin="0,24"/>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,9"><Path Data="{StaticResource DownloadIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="{Binding DownloaderSectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <TextBlock Text="{Binding ToolRefreshHint}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,12"/>
   <Button x:Name="ToolRefreshAnchor" Content="{Binding ToolRefreshLabel}" Command="{Binding ToolRefreshCommand}" HorizontalAlignment="Left"
           AutomationProperties.HelpText="{Binding ToolRefreshHint}" ToolTipService.ShowOnDisabled="True" ToolTip="{StaticResource DownloaderHelp}"/>
   <StackPanel x:Name="ToolNoticeHost" FlowDirection="LeftToRight"/>
   <Border Height="1" Background="{DynamicResource Divider}" Margin="0,24"/>
   <Expander Header="{Binding DownloadLimitsLabel}" Foreground="{DynamicResource Ink}"><local:DownloadLimitsView/></Expander>
   <Border Height="1" Background="{DynamicResource Divider}" Margin="0,24"/>
   <local:ContactLinksView x:Name="ContactLinks"/>
  </StackPanel>
 </Border>
</UserControl>
