<UserControl x:Class="YouTubeDownloader.DownloadFormView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YouTubeDownloader"
 FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}">
 <UserControl.Resources>
  <Style x:Key="FormCaption" TargetType="TextBlock">
   <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </UserControl.Resources>
 <StackPanel x:Name="FormContentPanel" Margin="24,16,24,24" FlowDirection="{Binding ContentDirection}">
  <Border x:Name="LinkWell" Background="{DynamicResource Surface}" CornerRadius="8" Padding="18,16">
   <StackPanel>
    <TextBlock Text="{Binding LinkLabel}" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid FlowDirection="LeftToRight">
      <TextBox x:Name="LinkInput" Text="{Binding Url,UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource LatinFont}" FontSize="14" Height="48" Padding="40,10,12,10"
       FlowDirection="LeftToRight" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding LinkLabel}" ToolTip="{Binding LinkShortcutHint}" AutomationProperties.AcceleratorKey="Ctrl+L"/>
      <Path Data="{StaticResource LinkIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" FlowDirection="LeftToRight"/>
      <TextBlock x:Name="LinkPlaceholder" Text="{Binding LinkPlaceholder}" Foreground="{DynamicResource Muted}" FontSize="14" Margin="40,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" FlowDirection="{Binding ContentDirection}">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Url}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
     <Button x:Name="PasteButton" Grid.Column="2" Content="{Binding PasteLabel}" Command="{Binding PasteCommand}" MinWidth="76" Height="48"/>
    </Grid>
    <TextBlock Text="{Binding DownloadIntro}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel>
  </Border>
  <local:DownloadActivityView x:Name="InlineActivity" Visibility="{Binding ShowInlineActivity,Converter={StaticResource BoolVisibility}}" Margin="0,14,0,0"/>
  <StackPanel x:Name="InlinePreviewHost" Margin="0,16,0,0">
   <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding InlineMediaPreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
  </StackPanel>
  <StackPanel Margin="0,24,0,0">
   <TextBlock Text="{Binding DownloadOptionsLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <StackPanel Visibility="{Binding HasPlaylist,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16">
   <UniformGrid Columns="2">
    <RadioButton Content="{Binding SingleLabel}" IsChecked="{Binding SingleVideo}" IsEnabled="{Binding CanSelectSingle}" Margin="0,0,5,0"/>
    <RadioButton Content="{Binding PlaylistLabel}" IsChecked="{Binding WholePlaylist}" IsEnabled="{Binding IsIdle}" Margin="5,0,0,0"/>
   </UniformGrid>
   <Button Content="{Binding PlaylistSelectionLabel}" Command="{Binding PlaylistSelectionCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
  </StackPanel>
   <Grid x:Name="FormatRow" Margin="0,0,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="FormatCaption" Text="{Binding FormatLabel}" Style="{StaticResource FormCaption}"/>
  <UniformGrid x:Name="FormatPicker" Grid.Column="1" Columns="2">
   <RadioButton x:Name="VideoChoice" IsChecked="{Binding Video}" IsEnabled="{Binding IsIdle}" GroupName="MediaKind" Style="{StaticResource FormatSegment}" Margin="0,0,5,0" AutomationProperties.Name="{Binding VideoLabel}" AutomationProperties.HelpText="{Binding VideoFormatLabel}" Click="VideoClicked" PreviewKeyDown="VideoKeyDown" ContextMenuOpening="VideoMenuOpening">
    <RadioButton.ContextMenu><ContextMenu x:Name="VideoFormatMenu" Style="{StaticResource OutputFormatMenu}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}" FontSize="14"/></RadioButton.ContextMenu>
    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource VideoIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource MediaVideo}" Margin="0,0,8,0"/><TextBlock Text="{Binding VideoLabel}"/><Path Data="{StaticResource ChevronIcon}" Style="{StaticResource LineIcon}" Width="10" Height="7" Margin="10,0,0,0"/></StackPanel>
   </RadioButton>
   <RadioButton x:Name="AudioChoice" IsChecked="{Binding Audio}" IsEnabled="{Binding IsIdle}" GroupName="MediaKind" Style="{StaticResource FormatSegment}" Margin="5,0,0,0" AutomationProperties.Name="{Binding AudioLabel}" AutomationProperties.HelpText="{Binding AudioFormatLabel}"
                Click="AudioClicked" PreviewKeyDown="AudioKeyDown" ContextMenuOpening="AudioMenuOpening">
    <RadioButton.ContextMenu>
     <ContextMenu x:Name="AudioFormatMenu" Style="{StaticResource OutputFormatMenu}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}" FontSize="14"/>
    </RadioButton.ContextMenu>
    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource AudioIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource MediaAudio}" Margin="0,0,8,0"/><TextBlock Text="{Binding AudioLabel}"/><Path Data="{StaticResource ChevronIcon}" Style="{StaticResource LineIcon}" Width="10" Height="7" Margin="10,0,0,0"/></StackPanel>
   </RadioButton>
  </UniformGrid>
   </Grid>
   <Grid x:Name="OutputControls" Margin="0,0,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="QualityCaption" Text="{Binding QualityLabel}" Style="{StaticResource FormCaption}"/>
    <Grid x:Name="QualityControls" Grid.Column="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="QualityInput" ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseQuality}" AutomationProperties.Name="{Binding QualityLabel}">
      <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding Audio}" Value="True"><Setter Property="ToolTip" Value="{Binding AudioSourceHint}"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
     </ComboBox>
     <Button x:Name="MoreOptionsButton" Grid.Column="2" Command="{Binding OptionsCommand}" Padding="12,8" MinWidth="112" Height="44" ToolTip="{Binding OptionsHint}" AutomationProperties.Name="{Binding OptionsLabel}" AutomationProperties.HelpText="{Binding OptionsHint}">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SubtitlesEnabled}" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style>
      <StackPanel Orientation="Horizontal"><Path x:Name="SubtitleButtonIcon" Data="{StaticResource SubtitlesIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="18" Height="18" Margin="0,0,8,0" FlowDirection="LeftToRight"/><TextBlock Text="{Binding OptionsLabel}" VerticalAlignment="Center"/></StackPanel>
     </Button>
    </Grid>
   </Grid>
   <Grid x:Name="FolderAnchor">
    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="FolderCaption" Text="{Binding FolderLabel}" Style="{StaticResource FormCaption}"/>
    <Grid x:Name="FolderControls" Grid.Column="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
     <Button x:Name="DestinationPicker" Command="{Binding BrowseCommand}" HorizontalContentAlignment="Stretch" ToolTip="{Binding Folder}" AutomationProperties.Name="{Binding FolderAccessibleName}" Padding="12,8">
      <DockPanel>
       <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeFolderLabel}" Foreground="{DynamicResource Accent}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
       <Path DockPanel.Dock="Left" Data="{StaticResource FolderIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Margin="0,0,10,0"/>
       <TextBlock Text="{Binding FolderDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"/>
      </DockPanel>
     </Button>
     <Button Grid.Column="2" Command="{Binding OpenFolderCommand}" AutomationProperties.Name="{Binding OpenFolderLabel}" ToolTip="{Binding OpenFolderLabel}" Padding="10"><Path Data="{StaticResource OpenFolderIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}"/></Button>
    </Grid>
   </Grid>
  </StackPanel>
  <StackPanel x:Name="FolderNoticeHost" FlowDirection="LeftToRight"/>
  <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,18,0,0">
   <Grid x:Name="FormActions">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Button x:Name="AddToQueueButton" Command="{Binding AddQueueCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="12,6" MinHeight="44" VerticalAlignment="Top" AutomationProperties.Name="{Binding AddQueueLabel}" ToolTip="{Binding QueueShortcutHint}">
     <StackPanel Orientation="Horizontal"><local:QueueFeedbackView x:Name="QueueFeedback" Revision="{Binding QueueAdditionVersion}" Margin="0,0,8,0"/><TextBlock Text="{Binding AddQueueLabel}"/></StackPanel>
    </Button>
    <local:DownloadActionView x:Name="DownloadAction" Grid.Column="1" Width="200"/>
    <Button x:Name="FormCancel" Grid.Column="2" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" AutomationProperties.Name="{Binding CancelLabel}" HorizontalAlignment="Left" Height="44" Margin="12,4,0,0" Padding="12,6" VerticalAlignment="Top">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
      <DataTrigger Binding="{Binding DownloadActionState}" Value="{x:Static local:DownloadActionState.Downloading}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding IsCheckingMedia}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     </Style.Triggers></Style></Button.Style>
    </Button>
   </Grid>
  </Border>
 </StackPanel>
</UserControl>
