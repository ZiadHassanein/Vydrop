<UserControl x:Class="YouTubeDownloader.DownloadLimitsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Ink}" FontFamily="{Binding ContentFont}">
 <UserControl.Resources>
  <Style x:Key="NumericInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="TextAlignment" Value="Center"/><Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
   <Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Error}"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <StackPanel Margin="0,8,0,8">
  <TextBlock Text="{Binding DownloadLimitsHint}" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{Binding ConnectionsLabel}" VerticalAlignment="Center"/>
   <ComboBox Grid.Column="2" ItemsSource="{Binding ConnectionChoices}" SelectedItem="{Binding DownloadConnections}" AutomationProperties.Name="{Binding ConnectionsLabel}" FlowDirection="LeftToRight"/>
   <TextBlock Grid.Row="1" Text="{Binding SpeedLimitLabel}" VerticalAlignment="Center" Margin="0,12,0,0"/>
   <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
    <TextBox x:Name="SpeedLimitInput" Style="{StaticResource NumericInput}" Text="{Binding SpeedLimitKiB,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" FlowDirection="LeftToRight" MaxLength="7" AutomationProperties.Name="{Binding SpeedLimitLabel}" AutomationProperties.HelpText="{Binding WholeNumberHint}"/>
    <TextBlock Text="{Binding WholeNumberHint}" Foreground="{DynamicResource Error}" FontSize="12" Margin="0,5,0,0" Visibility="{Binding (Validation.HasError),ElementName=SpeedLimitInput,Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
   <TextBlock Grid.Row="2" Text="{Binding AttemptsLabel}" VerticalAlignment="Center" Margin="0,12,0,0"/>
   <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
    <TextBox x:Name="AttemptsInput" Style="{StaticResource NumericInput}" Text="{Binding QueueAttempts,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" FlowDirection="LeftToRight" MaxLength="1" AutomationProperties.Name="{Binding AttemptsLabel}" AutomationProperties.HelpText="{Binding WholeNumberHint}"/>
    <TextBlock Text="{Binding WholeNumberHint}" Foreground="{DynamicResource Error}" FontSize="12" Margin="0,5,0,0" Visibility="{Binding (Validation.HasError),ElementName=AttemptsInput,Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </Grid>
  <CheckBox IsChecked="{Binding DirectFileAcceleration}" Margin="0,14,0,0" AutomationProperties.Name="{Binding RangeAccelerationLabel}"><TextBlock Text="{Binding RangeAccelerationLabel}" TextWrapping="Wrap"/></CheckBox>
 </StackPanel>
</UserControl>
