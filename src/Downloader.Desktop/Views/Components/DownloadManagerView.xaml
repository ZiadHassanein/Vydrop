<UserControl x:Class="YouTubeDownloader.DownloadManagerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YouTubeDownloader"
 FontFamily="{Binding ContentFont}" FlowDirection="{Binding ContentDirection}" Background="{DynamicResource Page}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Themes/ManagerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="ManagerRoot" FlowDirection="{Binding ContentDirection}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="330"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <local:AppHeaderView x:Name="Header" Grid.ColumnSpan="2" FlowDirection="LeftToRight"/>
  <Border x:Name="NavigationSurface" FlowDirection="{Binding ContentDirection}" Background="Transparent">
   <ScrollViewer x:Name="NavigationViewport" FlowDirection="{Binding ContentDirection}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="NavigationItems" FlowDirection="{Binding ContentDirection}" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
     <ToggleButton IsChecked="{Binding IsAddDownloadPage,Mode=OneWay}" Command="{Binding NewDownloadCommand}" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource PlusIcon}" AutomationProperties.Name="{Binding AddDownloadLabel}" ToolTip="{Binding AddDownloadLabel}"><TextBlock Text="{Binding AddDownloadLabel}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></ToggleButton>
     <ToggleButton IsChecked="{Binding IsLibraryPage,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="all" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource LibraryIcon}" AutomationProperties.Name="{Binding LibraryLabel}" ToolTip="{Binding LibraryLabel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LibraryLabel}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Style="{StaticResource NavigationCount}" Tag="{Binding LibraryCount}"><TextBlock Text="{Binding LibraryCount}" Foreground="{DynamicResource NavigationSelectedInk}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></ToggleButton>
     <ToggleButton IsChecked="{Binding IsLibraryQueue,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="queue" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource QueueListIcon}" AutomationProperties.Name="{Binding QueueNavigationLabel}" ToolTip="{Binding QueueNavigationLabel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding QueueNavigationLabel}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Style="{StaticResource NavigationCount}" Tag="{Binding WaitingCount}"><TextBlock Text="{Binding WaitingCount}" Foreground="{DynamicResource NavigationSelectedInk}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></ToggleButton>
     <ToggleButton x:Name="HistoryButton" AutomationProperties.Name="{Binding HistoryAccessibleName}" ToolTip="{Binding HistoryShortcutHint}" AutomationProperties.AcceleratorKey="Ctrl+J" IsChecked="{Binding HistoryVisible,Mode=OneWay}" Command="{Binding HistoryCommand}" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource HistoryIcon}"><TextBlock Text="{Binding HistoryNavigationLabel}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></ToggleButton>
     <ToggleButton x:Name="SettingsButton" ToolTip="{Binding SettingsShortcutHint}" AutomationProperties.AcceleratorKey="Ctrl+," IsChecked="{Binding IsSettingsPage,Mode=OneWay}" Command="{Binding SettingsCommand}" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource SettingsGearIcon}" AutomationProperties.Name="{Binding SettingsLabel}"><TextBlock Text="{Binding SettingsLabel}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></ToggleButton>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <Grid x:Name="WorkspaceViewport" Grid.Row="1" ClipToBounds="True">
  <Grid x:Name="EditorHost" Visibility="Collapsed"/>
  <ContentControl x:Name="WorkspaceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
  <local:HistoryView x:Name="HistoryContent" DataContext="{Binding History}" Visibility="Collapsed"/>
  <Grid x:Name="LibraryContent" Margin="24,4,20,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding LibraryHeading}" FontSize="26" LineHeight="34" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="AddDownloadButton" Grid.Column="1" Command="{Binding NewDownloadCommand}" Margin="12,0,0,0" AutomationProperties.Name="{Binding AddDownloadLabel}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource VydropPrimary}"><Style.Triggers><DataTrigger Binding="{Binding IsQueuePage}" Value="True"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlusIcon}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Stretch="Uniform" Width="17" Height="17" Margin="0,0,10,0"/><TextBlock Text="{Binding AddDownloadLabel}"/></StackPanel></Button>
   </Grid>
   <Grid Grid.Row="1" Margin="0,0,0,8">
    <TextBox x:Name="SearchInput" Text="{Binding LibrarySearch,UpdateSourceTrigger=PropertyChanged}" TextAlignment="{Binding InputTextAlignment}" Padding="38,10,12,10" MinHeight="44" AutomationProperties.Name="{Binding LibrarySearchLabel}"/>
    <Path Data="{StaticResource ManagerSearchIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="17" Height="17" HorizontalAlignment="Left" Margin="13,0" IsHitTestVisible="False"/>
    <TextBlock Text="{Binding LibrarySearchLabel}" Foreground="{DynamicResource Muted}" Margin="39,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LibrarySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <WrapPanel x:Name="QueueActions" FlowDirection="LeftToRight" Grid.Row="2" Margin="0,4,0,12" Visibility="{Binding IsQueuePage,Converter={StaticResource BoolVisibility}}">
    <Button x:Name="StartQueueButton" Command="{Binding QueuePrimaryCommand}" Click="StartQueueClicked" Style="{StaticResource VydropPrimary}" Margin="0,0,10,6" AutomationProperties.Name="{Binding StartQueueLabel}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ManagerPlayIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource OnAccent}" Width="15" Height="15" Margin="0,0,8,0"/><TextBlock Text="{Binding StartQueueLabel}"/></StackPanel></Button>
    <Button x:Name="PauseQueueButton" Command="{Binding QueuePauseCommand}" Margin="0,0,10,6" AutomationProperties.Name="{Binding PauseQueueLabel}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ManagerPauseIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="15" Height="15" Margin="0,0,8,0"/><TextBlock Text="{Binding PauseQueueLabel}"/></StackPanel></Button>
    <Button Command="{Binding QueueCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,6" AutomationProperties.Name="{Binding AddQueueLabel}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlusIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="{Binding AddQueueLabel}"/></StackPanel></Button>
   </WrapPanel>
   <WrapPanel x:Name="LibraryFilters" Grid.Row="3" Margin="0,0,0,10" Visibility="{Binding IsSavedLibrary,Converter={StaticResource BoolVisibility}}">
    <ToggleButton IsChecked="{Binding IsScopeAll,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="all" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AllFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding LibraryCount}"><TextBlock Text="{Binding LibraryCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryVideo,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="video" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding VideosLabel}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding VideoCount}"><TextBlock Text="{Binding VideoCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryAudio,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="audio" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AudioLibraryLabel}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding AudioCount}"><TextBlock Text="{Binding AudioCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
   </WrapPanel>
   <WrapPanel x:Name="QueueFilters" Grid.Row="3" Margin="0,0,0,10" Visibility="{Binding IsQueuePage,Converter={StaticResource BoolVisibility}}">
    <ToggleButton IsChecked="{Binding IsScopeAll,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="queue" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AllFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding WaitingCount}"><TextBlock Text="{Binding WaitingCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryActive,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="active" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ActiveFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding ActiveCount}"><TextBlock Text="{Binding ActiveCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryPending,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="pending" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding WaitingFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding PendingCount}"><TextBlock Text="{Binding PendingCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryPaused,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="paused" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PausedFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding PausedCount}"><TextBlock Text="{Binding PausedCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
   </WrapPanel>
   <ListBox x:Name="DownloadsList" FlowDirection="LeftToRight" FontFamily="{StaticResource LatinFont}" Grid.Row="4" ItemsSource="{Binding LibraryItems}" SelectedItem="{Binding SelectedLibraryItem}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource LibraryRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" MouseDoubleClick="DownloadDoubleClicked" AutomationProperties.Name="{Binding LibraryHeading}">
    <ListBox.ItemsPanel><ItemsPanelTemplate><local:StableVirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer Focusable="False" CanContentScroll="True" Background="Transparent" Style="{StaticResource InsetScrollFrame}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
    <ListBox.ItemTemplate><DataTemplate>
     <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,0,0,0">
      <Grid x:Name="RowContent" Height="84" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="158"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="20"/><RowDefinition Height="34"/><RowDefinition Height="4"/></Grid.RowDefinitions>
       <Border x:Name="RowArtwork" ToolTip="{Binding Title}" Background="{DynamicResource Surface}" CornerRadius="6" Width="144" Height="84" Grid.RowSpan="4" HorizontalAlignment="Left" ClipToBounds="True" VerticalAlignment="Top">
        <Grid><Path Data="{Binding MediaIcon}" Style="{StaticResource LineIcon}" Stroke="{Binding MediaBrush}" Width="25" Height="25"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/><TextBlock Text="{Binding Duration}" Background="#B0000000" Foreground="White" FontSize="10" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
       </Border>
       <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="RowTitleHost" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock x:Name="RowTitle" FlowDirection="{Binding Title,Converter={StaticResource TextDirection}}" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource LatinFont}"/><Style.Triggers><DataTrigger Binding="{Binding HasArabicTitle}" Value="True"><Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><DockPanel x:Name="RowStatusHost" Grid.Column="1" FlowDirection="LeftToRight" MaxWidth="144" ClipToBounds="True" VerticalAlignment="Center"><Path Data="{Binding StatusIcon}" Style="{StaticResource LineIcon}" Stroke="{Binding StateBrush}" Width="12" Height="12" Margin="0,0,5,0"/><TextBlock FlowDirection="{Binding RowStatus,Converter={StaticResource TextDirection}}" FontFamily="{Binding DataContext.ContentFont,RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding RowStatus}" Foreground="{Binding StateBrush}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding RowStatus}"/></DockPanel></Grid>
       <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ManagerSource}" HorizontalContentAlignment="Stretch"/>
       <Grid Grid.Column="1" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock ToolTip="{Binding RowDescription}" Text="{Binding RowDescription}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/><StackPanel x:Name="RowActions" Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight"><Button x:Name="RowPrimaryAction" Style="{StaticResource ManagerRowAction}" Command="{Binding DataContext.LibraryActionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" ToolTip="{Binding PrimaryAction}" AutomationProperties.Name="{Binding PrimaryAction}"><Path Data="{Binding ActionIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="18" Height="18"/></Button><Button x:Name="RowCancel" Style="{StaticResource ManagerRowAction}" Margin="4,0,0,0" Command="{Binding DataContext.LibraryCancelCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" ToolTip="{Binding DataContext.CancelLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding DataContext.CancelLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}"><Path Data="{StaticResource CloseIcon}" Style="{StaticResource LineIcon}" Width="16" Height="16"/></Button><Button x:Name="RowFolder" Style="{StaticResource ManagerRowAction}" Margin="4,0,0,0" Command="{Binding DataContext.OpenQueueFolderCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" ToolTip="{Binding FolderActionLabel}" AutomationProperties.Name="{Binding FolderActionLabel}" IsEnabled="{Binding CanOpenFolder}"><Path Data="{StaticResource OpenFolderIcon}" Style="{StaticResource LineIcon}" Width="16" Height="16"/></Button><Button x:Name="RowRefresh" Style="{StaticResource ManagerRowAction}" Margin="4,0,0,0" Command="{Binding DataContext.RefreshQueueSourceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" ToolTip="{Binding DataContext.RefreshSourceLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding DataContext.RefreshSourceLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding CanRefresh,Converter={StaticResource BoolVisibility}}"><Path Data="{StaticResource RefreshIcon}" Style="{StaticResource LineIcon}" Width="16" Height="16"/></Button><Button x:Name="RowDetails" Style="{StaticResource ManagerRowAction}" Margin="4,0,0,0" Command="{x:Static local:DownloadManagerView.ShowDetailsCommand}" CommandParameter="{Binding Id}" Visibility="{Binding IsCompact,RelativeSource={RelativeSource AncestorType=local:DownloadManagerView},Converter={StaticResource BoolVisibility}}" ToolTip="{Binding DataContext.DetailsLabel,RelativeSource={RelativeSource AncestorType=local:DownloadManagerView}}" AutomationProperties.Name="{Binding DataContext.DetailsLabel,RelativeSource={RelativeSource AncestorType=local:DownloadManagerView}}"><Path Data="{StaticResource InfoIcon}" Style="{StaticResource LineIcon}" Width="16" Height="16"/></Button><Button x:Name="RowRemove" Style="{StaticResource ManagerRowAction}" Margin="4,0,0,0" Command="{Binding DataContext.RemoveQueueCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" ToolTip="{Binding DataContext.RemoveLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding DataContext.RemoveLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding CanRemove}"><Path Data="{StaticResource TrashIcon}" Style="{StaticResource LineIcon}" Width="16" Height="16"/></Button></StackPanel></Grid>
       <ProgressBar Style="{StaticResource ManagerProgress}" Foreground="{Binding StateBrush}" Grid.Row="3" Grid.Column="1" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding IsPreparingWithoutProgress}" Margin="0" Height="4" Visibility="{Binding HasTransferProgress,Converter={StaticResource BoolVisibility}}"/>
      </Grid>
     </Border>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="350" Margin="22" Visibility="{Binding LibraryEmpty,Converter={StaticResource BoolVisibility}}">
    <Path Data="{StaticResource DownloadIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="36" Height="36" Margin="0,0,0,18"/>
    <TextBlock Text="{Binding EmptyLibraryHeading}" FontSize="20" LineHeight="28" FontWeight="SemiBold" TextAlignment="Center"/>
    <TextBlock Text="{Binding EmptyLibraryDetail}" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,10,0,20"/>
    <Button Content="{Binding AddDownloadLabel}" Command="{Binding NewDownloadCommand}" Style="{StaticResource VydropPrimary}" HorizontalAlignment="Center"/>
   </StackPanel>
   <TextBlock Grid.Row="5" Text="{Binding LibraryFooterLabel}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,8,0,10"/>
  </Grid>
  </Grid>
  <Border x:Name="DetailsBorder" Grid.Column="1" Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,0,0">
   <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource InsetScrollFrame}"><Grid x:Name="EditorDetailsHost" Visibility="Collapsed"/></ScrollViewer>
    <Grid x:Name="LibraryDetails">
    <TextBlock Text="{Binding SelectDownloadLabel}" Foreground="{DynamicResource Muted}" TextAlignment="Center" VerticalAlignment="Center" Margin="24"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasLibrarySelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ScrollViewer Style="{StaticResource InsetScrollFrame}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasLibrarySelection,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Surface}">
     <StackPanel x:Name="SelectedDetails" DataContext="{Binding SelectedLibraryItem}" Margin="20,0,20,20">
      <Border Background="{DynamicResource Field}" CornerRadius="6" Height="184" ClipToBounds="True" Margin="0,0,0,18"><Grid><Path Data="{Binding MediaIcon}" Style="{StaticResource LineIcon}" Stroke="{Binding MediaBrush}" Width="44" Height="44"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border>
      <TextBlock FlowDirection="{Binding Title,Converter={StaticResource TextDirection}}" ToolTip="{Binding Title}" Text="{Binding Title}" TextWrapping="Wrap" FontSize="23" LineHeight="32" FontWeight="SemiBold" MaxHeight="64" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource LatinFont}"/><Style.Triggers><DataTrigger Binding="{Binding HasArabicTitle}" Value="True"><Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ManagerSource}" Margin="0,10,0,8" HorizontalContentAlignment="Stretch"/>
      <TextBlock Text="{Binding OutputDescription}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,20"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MediaStatus}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock Grid.Column="1" Text="{Binding Percent,StringFormat={}{0:0}%}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></Grid>
      <ProgressBar Style="{StaticResource ManagerProgress}" Foreground="{Binding StateBrush}" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding IsPreparingWithoutProgress}" Margin="0,10,0,10"/>
      <WrapPanel Margin="0,0,0,8" FlowDirection="LeftToRight"><TextBlock Text="{Binding TransferSummary}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,12,5"/><TextBlock Text="{Binding Speed}" ToolTip="{Binding DataContext.TransferSpeedLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,12,5" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Remaining}" ToolTip="{Binding DataContext.TimeRemainingLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}" FontSize="12" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
      <Grid Margin="0,10,0,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="ManagerPrimaryButton" Command="{Binding DataContext.LibraryActionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Style="{StaticResource VydropPrimary}" AutomationProperties.Name="{Binding PrimaryAction}"><StackPanel Orientation="Horizontal"><Path Stroke="{DynamicResource OnAccent}" Width="16" Height="16" Margin="0,0,8,0"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource LineIcon}"><Setter Property="Data" Value="{StaticResource ManagerPlayIcon}"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Data" Value="{StaticResource ManagerPauseIcon}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><TextBlock Text="{Binding PrimaryAction}"/></StackPanel></Button>
       <Button x:Name="ManagerCancelButton" Grid.Column="1" Content="{Binding DataContext.CancelLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.LibraryCancelCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0" Padding="8" Style="{StaticResource QuietButton}"/>
      </Grid>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Error}" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0" FontSize="12"/>
      <Border Height="1" Background="{DynamicResource Divider}" Margin="0,22"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DataContext.SaveFolderLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"/><TextBlock x:Name="SelectedFolderPath" Text="{Binding FolderToOpen}" Foreground="{DynamicResource Muted}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" Margin="0,7,10,0" ToolTip="{Binding FolderToOpen}"/></StackPanel><Button Grid.Column="1" Command="{Binding DataContext.OpenLibraryFolderCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{Binding FolderActionLabel}" AutomationProperties.Name="{Binding FolderActionLabel}" Padding="9" Width="38" Height="38" VerticalAlignment="Center"><Path Data="{StaticResource OpenFolderIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}"/></Button></Grid>
      <Border Height="1" Background="{DynamicResource Divider}" Margin="0,22"/>
      <TextBlock Text="{Binding DataContext.OptionsLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding CaptionSummary}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
      <TextBlock Visibility="{Binding HasLocalFile,Converter={StaticResource BoolVisibility}}" Text="{Binding DataContext.SavedLocallyLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,28,0,0"/>
     </StackPanel>
    </ScrollViewer>
    </Grid>
   </Grid>
  </Border>
  <Grid x:Name="DetailOverlay" Grid.Row="1" Background="{DynamicResource Page}" Visibility="Collapsed" Panel.ZIndex="20">
   <Border Background="{DynamicResource Surface}" Margin="20,4,20,20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button x:Name="DetailsCloseButton" Content="{Binding BackToQueueLabel}" Click="HideDetailsClicked" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Margin="10"/><Grid x:Name="CompactDetailsHost" Grid.Row="1" MaxWidth="560"/></Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
