<UserControl x:Class="YouTubeDownloader.DownloadManagerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YouTubeDownloader"
 FontFamily="{Binding ContentFont}" FlowDirection="{Binding ContentDirection}" Background="{DynamicResource Page}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Themes/ManagerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="ManagerRoot" FlowDirection="{Binding ContentDirection}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="224"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="330"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="NavigationSurface" Grid.RowSpan="2" Background="{DynamicResource Navigation}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="BrandHost" Margin="22,24,14,12" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource InsetScrollFrame}">
     <StackPanel>
      <ToggleButton Content="{Binding AddDownloadLabel}" IsChecked="{Binding IsAddDownloadPage,Mode=OneWay}" Command="{Binding NewDownloadCommand}" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource PlusIcon}"/>
      <ToggleButton IsChecked="{Binding IsLibraryAll,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="all" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource LibraryIcon}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LibraryLabel}" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource NavigationCount}" Tag="{Binding LibraryCount}"><TextBlock Text="{Binding LibraryCount}" Foreground="{DynamicResource NavigationSelectedInk}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></ToggleButton>
      <ToggleButton IsChecked="{Binding IsLibraryQueue,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="queue" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource QueueListIcon}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding QueueNavigationLabel}" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource NavigationCount}" Tag="{Binding WaitingCount}"><TextBlock Text="{Binding WaitingCount}" Foreground="{DynamicResource NavigationSelectedInk}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></ToggleButton>
      <ToggleButton x:Name="HistoryButton" AutomationProperties.Name="{Binding HistoryAccessibleName}" ToolTip="{Binding HistoryShortcutHint}" AutomationProperties.AcceleratorKey="Ctrl+J" IsChecked="{Binding HistoryVisible,Mode=OneWay}" Content="{Binding HistoryNavigationLabel}" Command="{Binding HistoryCommand}" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource HistoryIcon}"/>
      <Border Height="1" Background="{DynamicResource NavigationSelected}" Margin="18,20"/>
      <TextBlock Text="{Binding MediaLabel}" Foreground="{DynamicResource NavigationMuted}" FontSize="12" Margin="24,0,0,10"/>
      <ToggleButton IsChecked="{Binding IsLibraryVideo,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="video" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource VideoIcon}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding VideosLabel}" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource NavigationCount}" Tag="{Binding VideoCount}"><TextBlock Text="{Binding VideoCount}" Foreground="{DynamicResource NavigationSelectedInk}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></ToggleButton>
      <ToggleButton IsChecked="{Binding IsLibraryAudio,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="audio" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource AudioIcon}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding AudioLibraryLabel}" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource NavigationCount}" Tag="{Binding AudioCount}"><TextBlock Text="{Binding AudioCount}" Foreground="{DynamicResource NavigationSelectedInk}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></ToggleButton>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,14">
     <Border Height="1" Background="{DynamicResource NavigationSelected}" Margin="18,0,18,10"/>
     <ToggleButton IsChecked="False" Content="{Binding BrowserLabel}" Command="{Binding BrowserCommand}" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource BrowserIcon}"/>
     <ToggleButton x:Name="SettingsButton" ToolTip="{Binding SettingsShortcutHint}" AutomationProperties.AcceleratorKey="Ctrl+," IsChecked="{Binding SettingsVisible,Mode=OneWay}" Content="{Binding SettingsLabel}" Command="{Binding SettingsCommand}" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource SettingsGearIcon}"/>
    </StackPanel>
   </Grid>
  </Border>
  <local:AppHeaderView x:Name="Header" Grid.Column="1" Grid.ColumnSpan="2" FlowDirection="LeftToRight"/>
  <Grid x:Name="EditorHost" Grid.Column="1" Grid.Row="1" Visibility="Collapsed"/>
  <local:HistoryView x:Name="HistoryContent" Grid.Column="1" Grid.Row="1" DataContext="{Binding History}" Visibility="Collapsed"/>
  <Grid x:Name="LibraryContent" Grid.Column="1" Grid.Row="1" Margin="24,4,20,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding LibraryHeading}" FontSize="34" LineHeight="44" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="AddDownloadButton" Grid.Column="1" Command="{Binding NewDownloadCommand}" Margin="12,0,0,0" AutomationProperties.Name="{Binding AddDownloadLabel}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource VydropPrimary}"><Style.Triggers><DataTrigger Binding="{Binding IsQueuePage}" Value="True"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlusIcon}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Stretch="Uniform" Width="17" Height="17" Margin="0,0,10,0"/><TextBlock Text="{Binding AddDownloadLabel}"/></StackPanel></Button>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding LibraryDescription}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
   </Grid>
   <Grid Grid.Row="1" Margin="0,0,0,8">
    <TextBox x:Name="SearchInput" Text="{Binding LibrarySearch,UpdateSourceTrigger=PropertyChanged}" Padding="38,10,12,10" MinHeight="44" AutomationProperties.Name="{Binding LibrarySearchLabel}"/>
    <Path Data="{StaticResource ManagerSearchIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="17" Height="17" HorizontalAlignment="Left" Margin="13,0" IsHitTestVisible="False"/>
    <TextBlock Text="{Binding LibrarySearchLabel}" Foreground="{DynamicResource Muted}" Margin="39,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LibrarySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <WrapPanel x:Name="QueueActions" Grid.Row="2" Margin="0,4,0,12" Visibility="{Binding IsQueuePage,Converter={StaticResource BoolVisibility}}">
    <Button x:Name="StartQueueButton" Command="{Binding QueueStartCommand}" Click="StartQueueClicked" Style="{StaticResource VydropPrimary}" Margin="0,0,10,6" AutomationProperties.Name="{Binding StartQueueLabel}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ManagerPlayIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource OnAccent}" Width="15" Height="15" Margin="0,0,8,0"/><TextBlock Text="{Binding StartQueueLabel}"/></StackPanel></Button>
    <Button x:Name="PauseQueueButton" Command="{Binding QueuePauseCommand}" Margin="0,0,10,6" AutomationProperties.Name="{Binding PauseQueueLabel}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ManagerPauseIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="15" Height="15" Margin="0,0,8,0"/><TextBlock Text="{Binding PauseQueueLabel}"/></StackPanel></Button>
    <Button Command="{Binding QueueCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,6" AutomationProperties.Name="{Binding ManageQueueLabel}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SlidersIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="{Binding ManageQueueLabel}"/></StackPanel></Button>
   </WrapPanel>
   <WrapPanel x:Name="LibraryFilters" Grid.Row="3" Margin="0,0,0,10" Visibility="{Binding IsSavedLibrary,Converter={StaticResource BoolVisibility}}">
    <ToggleButton IsChecked="{Binding IsScopeAll,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="all" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AllFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding LibraryCount}"><TextBlock Text="{Binding LibraryCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryVideo,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="video" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding VideosLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding VideoCount}"><TextBlock Text="{Binding VideoCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryAudio,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="audio" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AudioLibraryLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding AudioCount}"><TextBlock Text="{Binding AudioCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
   </WrapPanel>
   <WrapPanel x:Name="QueueFilters" Grid.Row="3" Margin="0,0,0,10" Visibility="{Binding IsQueuePage,Converter={StaticResource BoolVisibility}}">
    <ToggleButton IsChecked="{Binding IsScopeAll,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="queue" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AllFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding WaitingCount}"><TextBlock Text="{Binding WaitingCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryActive,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="active" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ActiveFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding ActiveCount}"><TextBlock Text="{Binding ActiveCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryPending,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="pending" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding WaitingFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding PendingCount}"><TextBlock Text="{Binding PendingCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryPaused,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="paused" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PausedFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding PausedCount}"><TextBlock Text="{Binding PausedCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
    <ToggleButton IsChecked="{Binding IsLibraryAttention,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="attention" Style="{StaticResource LibraryFilter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AttentionFilterLabel}" VerticalAlignment="Center"/><Border Style="{StaticResource ManagerCount}" Tag="{Binding AttentionCount}"><TextBlock Text="{Binding AttentionCount}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton>
   </WrapPanel>
   <ListBox x:Name="DownloadsList" Grid.Row="4" ItemsSource="{Binding LibraryItems}" SelectedItem="{Binding SelectedLibraryItem}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource LibraryRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" MouseDoubleClick="DownloadDoubleClicked" AutomationProperties.Name="{Binding LibraryHeading}">
    <ListBox.ItemsPanel><ItemsPanelTemplate><local:StableVirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer Focusable="False" CanContentScroll="True" Background="Transparent" Style="{StaticResource InsetScrollFrame}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
    <ListBox.ItemTemplate><DataTemplate>
     <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,0,0,0">
      <Grid Height="84"><Grid.ColumnDefinitions><ColumnDefinition Width="158"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions>
       <Border Background="{DynamicResource Surface}" CornerRadius="6" Width="144" Height="84" Grid.RowSpan="2" HorizontalAlignment="Left" ClipToBounds="True" VerticalAlignment="Top">
        <Grid><Path Data="{Binding MediaIcon}" Style="{StaticResource LineIcon}" Stroke="{Binding MediaBrush}" Width="25" Height="25"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/><TextBlock Text="{Binding Duration}" Background="#B0000000" Foreground="White" FontSize="10" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
       </Border>
       <StackPanel Grid.Column="1" Margin="0,0,10,0">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasArabicTitle}" Value="True"><Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/></DataTrigger><DataTrigger Binding="{Binding MissingFile}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ManagerSource}" Margin="0,3,0,0" HorizontalContentAlignment="Stretch"/>
        <TextBlock Text="{Binding RowDescription}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" LineHeight="18" FlowDirection="LeftToRight"/>
       </StackPanel>
       <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="144" MinWidth="78">
        <DockPanel FlowDirection="LeftToRight" HorizontalAlignment="Right"><Path Data="{Binding StatusIcon}" Style="{StaticResource LineIcon}" Stroke="{Binding StateBrush}" Width="12" Height="12" Margin="0,0,5,0"/><TextBlock Text="{Binding RowStatus}" Foreground="{Binding StateBrush}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding RowStatus}"/></DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
         <Button CommandParameter="{Binding Id}" Margin="0,0,4,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ManagerRowAction}"><Setter Property="Command" Value="{Binding DataContext.LibraryActionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"/><Setter Property="ToolTip" Value="{Binding PrimaryAction}"/><Setter Property="AutomationProperties.Name" Value="{Binding PrimaryAction}"/><Style.Triggers><DataTrigger Binding="{Binding IsComplete}" Value="True"><Setter Property="Command" Value="{Binding DataContext.OpenQueueFolderCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"/><Setter Property="ToolTip" Value="{Binding DataContext.OpenSaveFolderLabel,RelativeSource={RelativeSource AncestorType=UserControl}}"/><Setter Property="AutomationProperties.Name" Value="{Binding DataContext.OpenSaveFolderLabel,RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTrigger></Style.Triggers></Style></Button.Style><Path Data="{Binding ActionIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="18" Height="18"/></Button>
         <Button Click="RowMoreClicked" Style="{StaticResource ManagerRowAction}" AutomationProperties.Name="{Binding DataContext.MoreActionsLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{Binding DataContext.MoreActionsLabel,RelativeSource={RelativeSource AncestorType=UserControl}}"><Path Data="{StaticResource MoreIcon}" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="16" Height="4"/></Button>
        </StackPanel>
       </StackPanel>
       <ProgressBar Style="{StaticResource ManagerProgress}" Foreground="{Binding StateBrush}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding IsPreparing}" Margin="0" Height="4" Visibility="{Binding HasTransferProgress,Converter={StaticResource BoolVisibility}}"/>
      </Grid>
     </Border>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="350" Margin="22" Visibility="{Binding LibraryEmpty,Converter={StaticResource BoolVisibility}}">
    <Path Data="{StaticResource DownloadIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="36" Height="36" Margin="0,0,0,18"/>
    <TextBlock Text="{Binding EmptyLibraryHeading}" FontSize="23" LineHeight="32" FontWeight="SemiBold" TextAlignment="Center"/>
    <TextBlock Text="{Binding EmptyLibraryDetail}" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,10,0,20"/>
    <Button Content="{Binding AddDownloadLabel}" Command="{Binding NewDownloadCommand}" Style="{StaticResource VydropPrimary}" HorizontalAlignment="Center"/>
   </StackPanel>
   <DockPanel Grid.Row="5" Margin="0,8,0,10"><TextBlock Text="{Binding LibraryFooterLabel}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button x:Name="CompactDetailsButton" DockPanel.Dock="Right" Content="{Binding DetailsLabel}" Click="ShowDetailsClicked" Visibility="Collapsed" Style="{StaticResource QuietButton}" MinHeight="30" Padding="8,3"/></DockPanel>
  </Grid>
  <Border x:Name="DetailsBorder" Grid.Column="2" Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,0,0">
   <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource InsetScrollFrame}"><Grid x:Name="EditorDetailsHost" Visibility="Collapsed"/></ScrollViewer>
    <Grid x:Name="LibraryDetails">
    <TextBlock Text="{Binding SelectDownloadLabel}" Foreground="{DynamicResource Muted}" TextAlignment="Center" VerticalAlignment="Center" Margin="24"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasLibrarySelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ScrollViewer Style="{StaticResource InsetScrollFrame}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasLibrarySelection,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Surface}">
     <StackPanel x:Name="SelectedDetails" DataContext="{Binding SelectedLibraryItem}" Margin="20,0,20,20">
      <Border Background="{DynamicResource Field}" CornerRadius="6" Height="184" ClipToBounds="True" Margin="0,0,0,18"><Grid><Path Data="{Binding MediaIcon}" Style="{StaticResource LineIcon}" Stroke="{Binding MediaBrush}" Width="44" Height="44"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border>
      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="23" LineHeight="32" FontWeight="SemiBold" MaxHeight="64" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasArabicTitle}" Value="True"><Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/></DataTrigger><DataTrigger Binding="{Binding MissingFile}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ManagerSource}" Margin="0,10,0,8" HorizontalContentAlignment="Stretch"/>
      <TextBlock Text="{Binding OutputDescription}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,20"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MediaStatus}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock Grid.Column="1" Text="{Binding Percent,StringFormat={}{0:0}%}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></Grid>
      <ProgressBar Style="{StaticResource ManagerProgress}" Foreground="{Binding StateBrush}" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding IsPreparing}" Margin="0,10,0,10"/>
      <WrapPanel Margin="0,0,0,8" FlowDirection="LeftToRight"><TextBlock Text="{Binding TransferSummary}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,12,5"/><TextBlock Text="{Binding Speed}" ToolTip="{Binding DataContext.TransferSpeedLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,12,5" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Remaining}" ToolTip="{Binding DataContext.TimeRemainingLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}" FontSize="12" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="ManagerPrimaryButton" Command="{Binding DataContext.LibraryActionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Style="{StaticResource VydropPrimary}" AutomationProperties.Name="{Binding PrimaryAction}"><StackPanel Orientation="Horizontal"><Path Stroke="{DynamicResource OnAccent}" Width="16" Height="16" Margin="0,0,8,0"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource LineIcon}"><Setter Property="Data" Value="{StaticResource ManagerPlayIcon}"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Data" Value="{StaticResource ManagerPauseIcon}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><TextBlock Text="{Binding PrimaryAction}"/></StackPanel></Button>
       <Button x:Name="ManagerCancelButton" Grid.Column="1" Content="{Binding DataContext.CancelLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.LibraryCancelCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0" Padding="8" Style="{StaticResource QuietButton}"/>
      </Grid>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Error}" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0" FontSize="12"/>
      <Border Height="1" Background="{DynamicResource Divider}" Margin="0,22"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DataContext.SaveFolderLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"/><TextBlock x:Name="SelectedFolderPath" Text="{Binding SaveFolder}" Foreground="{DynamicResource Muted}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" Margin="0,7,10,0" ToolTip="{Binding SaveFolder}"/></StackPanel><Button Grid.Column="1" Command="{Binding DataContext.OpenLibraryFolderCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{Binding DataContext.OpenSaveFolderLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding DataContext.OpenSaveFolderLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="9" Width="38" Height="38" VerticalAlignment="Center"><Path Data="{StaticResource OpenFolderIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}"/></Button></Grid>
      <Border Height="1" Background="{DynamicResource Divider}" Margin="0,22"/>
      <TextBlock Text="{Binding DataContext.OptionsLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding CaptionSummary}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
      <TextBlock Visibility="{Binding HasLocalFile,Converter={StaticResource BoolVisibility}}" Text="{Binding DataContext.SavedLocallyLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,28,0,0"/>
     </StackPanel>
    </ScrollViewer>
    </Grid>
   </Grid>
  </Border>
  <Grid x:Name="DetailOverlay" Grid.RowSpan="2" Grid.ColumnSpan="3" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="20" KeyboardNavigation.TabNavigation="Cycle">
   <Border Background="{DynamicResource Surface}" HorizontalAlignment="Right" Width="340" Margin="20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button x:Name="DetailsCloseButton" Content="{Binding CloseLabel}" Click="HideDetailsClicked" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Margin="10"/><Grid x:Name="CompactDetailsHost" Grid.Row="1"/></Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
