<UserControl x:Class="YouTubeDownloader.DownloadManagerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YouTubeDownloader"
 FontFamily="{Binding ContentFont}" FlowDirection="{Binding ContentDirection}" Background="{DynamicResource Page}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Themes/ManagerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="ManagerRoot" FlowDirection="{Binding ContentDirection}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="330"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="NavigationSurface" Grid.RowSpan="2" Background="{DynamicResource Navigation}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="BrandHost" Margin="22,24,14,12" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource InsetScrollFrame}">
     <StackPanel>
      <ToggleButton Content="{Binding LibraryLabel}" IsChecked="{Binding IsLibraryAll,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="all" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource LibraryIcon}"/>
      <ToggleButton Content="{Binding QueueNavigationLabel}" IsChecked="{Binding IsLibraryQueue,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="queue" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource QueueListIcon}"/>
      <ToggleButton IsChecked="False" Content="{Binding HistoryNavigationLabel}" Command="{Binding HistoryCommand}" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource HistoryIcon}"/>
      <Border Height="1" Background="{DynamicResource NavigationSelected}" Margin="18,20"/>
      <TextBlock Text="{Binding MediaLabel}" Foreground="{DynamicResource NavigationMuted}" FontSize="12" Margin="24,0,0,10"/>
      <ToggleButton IsChecked="{Binding IsLibraryVideo,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="video" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource VideoIcon}"><DockPanel><TextBlock Text="{Binding VideosLabel}"/><TextBlock Text="{Binding VideoCount}" Foreground="{DynamicResource NavigationMuted}" Margin="12,0,0,0"/></DockPanel></ToggleButton>
      <ToggleButton IsChecked="{Binding IsLibraryAudio,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="audio" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource AudioIcon}"><DockPanel><TextBlock Text="{Binding AudioLibraryLabel}"/><TextBlock Text="{Binding AudioCount}" Foreground="{DynamicResource NavigationMuted}" Margin="12,0,0,0"/></DockPanel></ToggleButton>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,14">
     <Border Height="1" Background="{DynamicResource NavigationSelected}" Margin="18,0,18,10"/>
     <ToggleButton IsChecked="False" Content="{Binding BrowserLabel}" Command="{Binding BrowserCommand}" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource GlobeIcon}"/>
     <ToggleButton IsChecked="{Binding SettingsVisible,Mode=OneWay}" Content="{Binding SettingsLabel}" Command="{Binding SettingsCommand}" Style="{StaticResource LibraryNavigation}" Tag="{StaticResource SettingsGearIcon}"/>
     <Border x:Name="FooterContent" Margin="16,4,12,0"><local:AppFooterView x:Name="ContactLinks"/></Border>
     <TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource NavigationMuted}" Margin="24,12,0,0" FontSize="11" FlowDirection="LeftToRight"/>
    </StackPanel>
   </Grid>
  </Border>
  <local:AppHeaderView x:Name="Header" Grid.Column="1" Grid.ColumnSpan="2" FlowDirection="LeftToRight"/>
  <Grid x:Name="LibraryContent" Grid.Column="1" Grid.Row="1" Margin="24,4,20,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding LibraryHeading}" FontSize="27" LineHeight="36" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="AddDownloadButton" Grid.Column="1" Command="{Binding NewDownloadCommand}" Style="{StaticResource VydropPrimary}" Margin="12,0,0,0" AutomationProperties.Name="{Binding AddDownloadLabel}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlusIcon}" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="17" Height="17" Margin="0,0,10,0"/><TextBlock Text="{Binding AddDownloadLabel}"/></StackPanel></Button>
   </Grid>
   <Grid Grid.Row="1" Margin="0,0,0,8">
    <TextBox x:Name="SearchInput" Text="{Binding LibrarySearch,UpdateSourceTrigger=PropertyChanged}" Padding="12,8" MinHeight="40" AutomationProperties.Name="{Binding LibrarySearchLabel}"/>
    <TextBlock Text="{Binding LibrarySearchLabel}" Foreground="{DynamicResource Muted}" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LibrarySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <WrapPanel>
     <ToggleButton Content="{Binding AllFilterLabel}" IsChecked="{Binding IsLibraryAll,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="all" Style="{StaticResource LibraryFilter}"/>
     <ToggleButton Content="{Binding ActiveFilterLabel}" IsChecked="{Binding IsLibraryActive,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="active" Style="{StaticResource LibraryFilter}"/>
     <ToggleButton Content="{Binding PausedFilterLabel}" IsChecked="{Binding IsLibraryPaused,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="paused" Style="{StaticResource LibraryFilter}"/>
     <ToggleButton Content="{Binding CompletedFilterLabel}" IsChecked="{Binding IsLibraryComplete,Mode=OneWay}" Command="{Binding LibraryFilterCommand}" CommandParameter="complete" Style="{StaticResource LibraryFilter}"/>
    </WrapPanel>
    <Button Grid.Column="1" Command="{Binding QueueCommand}" Style="{StaticResource QuietButton}" Padding="7" MinHeight="32" ToolTip="{Binding ManageQueueLabel}" AutomationProperties.Name="{Binding ManageQueueLabel}"><Path Data="M2,5 H20 M2,11 H20 M2,17 H20 M6,2 V8 M15,8 V14 M8,14 V20" Style="{StaticResource LineIcon}" Width="18" Height="18"/></Button>
   </Grid>
   <ListBox x:Name="DownloadsList" Grid.Row="3" ItemsSource="{Binding LibraryItems}" SelectedItem="{Binding SelectedLibraryItem}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource LibraryRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" MouseDoubleClick="DownloadDoubleClicked" AutomationProperties.Name="{Binding LibraryHeading}">
    <ListBox.ItemTemplate><DataTemplate>
     <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="102"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Background="{DynamicResource Surface}" CornerRadius="5" Width="92" Height="60" ClipToBounds="True" VerticalAlignment="Top">
        <Grid><Path Data="{Binding MediaIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="25" Height="25"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/><TextBlock Text="{Binding Duration}" Background="#B0000000" Foreground="White" FontSize="10" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
       </Border>
       <StackPanel Grid.Column="1" Margin="0,0,10,0">
        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasArabicTitle}" Value="True"><Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/></DataTrigger><DataTrigger Binding="{Binding MissingFile}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        <TextBlock Text="{Binding OutputDescription}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0" FlowDirection="LeftToRight"/>
       </StackPanel>
       <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="126">
        <TextBlock Text="{Binding MediaStatus}" Foreground="{Binding StateBrush}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding MediaStatus}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
         <Button Content="{Binding PrimaryAction}" Command="{Binding DataContext.LibraryActionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Style="{StaticResource QuietButton}" FontSize="11" Padding="5,3" MinHeight="28"/>
         <Button Click="RowMoreClicked" Style="{StaticResource QuietButton}" Padding="6,0" MinHeight="28" MinWidth="28" AutomationProperties.Name="{Binding DataContext.MoreActionsLabel,RelativeSource={RelativeSource AncestorType=UserControl}}"><Path Data="{StaticResource MoreIcon}" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="16" Height="4"/></Button>
        </StackPanel>
       </StackPanel>
       <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding IsPreparing}" Height="3" Margin="0,8,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Divider}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}"/>
      </Grid>
     </Border>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="350" Margin="22" Visibility="{Binding LibraryEmpty,Converter={StaticResource BoolVisibility}}">
    <Path Data="{StaticResource DownloadIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="36" Height="36" Margin="0,0,0,18"/>
    <TextBlock Text="{Binding EmptyLibraryHeading}" FontSize="23" LineHeight="32" FontWeight="SemiBold" TextAlignment="Center"/>
    <TextBlock Text="{Binding EmptyLibraryDetail}" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,10,0,20"/>
    <Button Content="{Binding AddDownloadLabel}" Command="{Binding NewDownloadCommand}" Style="{StaticResource VydropPrimary}" HorizontalAlignment="Center"/>
   </StackPanel>
   <DockPanel Grid.Row="4" Margin="0,8,0,10"><TextBlock Text="{Binding LibraryFooterLabel}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button x:Name="CompactDetailsButton" DockPanel.Dock="Right" Content="{Binding DetailsLabel}" Click="ShowDetailsClicked" Visibility="Collapsed" Style="{StaticResource QuietButton}" MinHeight="30" Padding="8,3"/></DockPanel>
  </Grid>
  <Border x:Name="DetailsBorder" Grid.Column="2" Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,0,0">
   <Grid>
    <TextBlock Text="{Binding SelectDownloadLabel}" Foreground="{DynamicResource Muted}" TextAlignment="Center" VerticalAlignment="Center" Margin="24"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasLibrarySelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ScrollViewer Style="{StaticResource InsetScrollFrame}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasLibrarySelection,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Surface}">
     <StackPanel x:Name="SelectedDetails" DataContext="{Binding SelectedLibraryItem}" Margin="16,0,16,20">
      <Border Background="{DynamicResource Field}" CornerRadius="5" Height="178" ClipToBounds="True" Margin="0,0,0,18"><Grid><Path Data="{Binding MediaIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Accent}" Width="44" Height="44"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border>
      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="23" LineHeight="32" FontWeight="SemiBold" MaxHeight="64" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasArabicTitle}" Value="True"><Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/></DataTrigger><DataTrigger Binding="{Binding MissingFile}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,6,0,8" FlowDirection="LeftToRight"/>
      <TextBlock Text="{Binding OutputDescription}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,24"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MediaStatus}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock Grid.Column="1" Text="{Binding Percent,StringFormat={}{0:0}%}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></Grid>
      <ProgressBar Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding IsPreparing}" Foreground="{DynamicResource Accent}" Background="{DynamicResource Divider}" Height="5" Margin="0,10,0,10"/>
      <TextBlock Text="{Binding TransferSummary}" Foreground="{DynamicResource Muted}" FontSize="12"/>
      <Grid Margin="0,16,0,16" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{Binding DataContext.TransferSpeedLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding Speed}" FontSize="14" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding DataContext.TimeRemainingLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding Remaining}" FontSize="14" Margin="0,4,0,0"/></StackPanel>
      </Grid>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="ManagerPrimaryButton" Content="{Binding PrimaryAction}" Command="{Binding DataContext.LibraryActionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Style="{StaticResource VydropPrimary}"/>
       <Button x:Name="ManagerCancelButton" Grid.Column="1" Content="{Binding DataContext.CancelLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.LibraryCancelCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0" Padding="12,8"/>
      </Grid>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Error}" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0" FontSize="12"/>
      <Border Height="1" Background="{DynamicResource Divider}" Margin="0,22"/>
      <TextBlock Text="{Binding DataContext.SaveFolderLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding SaveFolder}" Foreground="{DynamicResource Muted}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" MaxHeight="44" FontSize="12" Margin="0,8,0,12" ToolTip="{Binding SaveFolder}"/>
      <Button Content="{Binding DataContext.OpenSaveFolderLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.OpenLibraryFolderCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12"/>
      <Border Height="1" Background="{DynamicResource Divider}" Margin="0,22"/>
      <TextBlock Text="{Binding DataContext.OptionsLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding CaptionSummary}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
      <TextBlock Visibility="{Binding HasLocalFile,Converter={StaticResource BoolVisibility}}" Text="{Binding DataContext.SavedLocallyLabel,RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,28,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Border>
  <Grid x:Name="DetailOverlay" Grid.RowSpan="2" Grid.ColumnSpan="3" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="20" KeyboardNavigation.TabNavigation="Cycle">
   <Border Background="{DynamicResource Surface}" HorizontalAlignment="Right" Width="340" Margin="20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button x:Name="DetailsCloseButton" Content="{Binding CloseLabel}" Click="HideDetailsClicked" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Margin="10"/><Grid x:Name="CompactDetailsHost" Grid.Row="1"/></Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
