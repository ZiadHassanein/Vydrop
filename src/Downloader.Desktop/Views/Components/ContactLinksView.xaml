<UserControl x:Class="YouTubeDownloader.ContactLinksView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="{Binding ContentDirection}" FontFamily="{Binding ContentFont}">
 <UserControl.Resources>
  <Geometry x:Key="ContactRepositoryIcon">M6,7 A2,2 0 1 1 6,3 A2,2 0 1 1 6,7 M6,7 L6,15 M6,19 A2,2 0 1 1 6,15 A2,2 0 1 1 6,19 M16,7 A2,2 0 1 1 16,3 A2,2 0 1 1 16,7 M16,7 L16,9 Q16,12 13,12 L9,12 Q6,12 6,15</Geometry>
  <Geometry x:Key="ContactProfileIcon">M3,2 H19 Q21,2 21,4 V20 Q21,22 19,22 H3 Q1,22 1,20 V4 Q1,2 3,2 Z M6,10 V17 M6,6 V6.2 M11,17 V10 M11,12 C11,9 17,9 17,12 V17</Geometry>
  <Geometry x:Key="ContactEmailIcon">M4,4 H20 Q22,4 22,6 V18 Q22,20 20,20 H4 Q2,20 2,18 V6 Q2,4 4,4 Z M2,6 L12,13 22,6</Geometry>
  <Style x:Key="ContactLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Margin" Value="0,0,10,8"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="MinHeight" Value="40"/>
  </Style>
 </UserControl.Resources>
 <StackPanel x:Name="ContactSection" FlowDirection="{Binding ContentDirection}" AutomationProperties.Name="{Binding ContactLabel}">
  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
   <Path Data="{StaticResource ContactEmailIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="18" Height="18" Margin="0,0,10,0"/>
   <TextBlock x:Name="ContactHeading" Text="{Binding ContactLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </StackPanel>
  <WrapPanel x:Name="ContactActions" KeyboardNavigation.TabNavigation="Continue">
   <Button x:Name="GitHubContact" Command="{Binding SocialCommand}" CommandParameter="github" Style="{StaticResource ContactLink}" AutomationProperties.Name="GitHub">
    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight"><Path Data="{StaticResource ContactRepositoryIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="GitHub" VerticalAlignment="Center"/></StackPanel>
   </Button>
   <Button x:Name="LinkedInContact" Command="{Binding SocialCommand}" CommandParameter="linkedin" Style="{StaticResource ContactLink}" AutomationProperties.Name="LinkedIn">
    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight"><Path Data="{StaticResource ContactProfileIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="LinkedIn" VerticalAlignment="Center"/></StackPanel>
   </Button>
   <Button x:Name="EmailContact" Command="{Binding SocialCommand}" CommandParameter="email" Style="{StaticResource ContactLink}" AutomationProperties.Name="{Binding EmailLabel}">
    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource ContactEmailIcon}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource Muted}" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="{Binding EmailLabel}" VerticalAlignment="Center"/></StackPanel>
   </Button>
  </WrapPanel>
 </StackPanel>
</UserControl>
